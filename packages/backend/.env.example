# Convex Configuration
# Deployment name for `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-project.convex.cloud
CONVEX_SITE_URL=https://your-project.convex.site

# Better Auth Configuration
BETTER_AUTH_SECRET=your-secret-here

# Site URLs (for trustedOrigins and redirects)
SITE_URL=http://localhost:3000
WEB_SITE_URL=http://localhost:3000
CLIENT_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:3001
DOCS_SITE_URL=http://localhost:3002

# Social Auth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
